---
import Arrow from '../../components/Arrow.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQList from '../../components/FAQList.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, type Service } from '../../data/services';
import { siteConfig } from '../../data/site';
import { getKeywordTarget, keywordLabel } from '../../lib/seo-keywords';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const relatedServices = service.related
  .map((slug) => services.find((item) => item.slug === slug))
  .filter((item): item is Service => Boolean(item));

const pageUrl = `${siteConfig.url}/services/${service.slug}/`;
const pagePath = `/services/${service.slug}/`;
const seo = getKeywordTarget(pagePath);
const schema = [
  {
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: service.title,
    description: service.seoDescription,
    url: pageUrl,
    image: new URL(service.image, siteConfig.url).toString(),
    serviceType: service.title,
    areaServed: { '@type': 'City', name: 'Philadelphia' },
    provider: { '@id': `${siteConfig.url}/#organization` },
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteConfig.url}/services/` },
      { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={keywordLabel(seo.primaryKeyword)} description={service.seoDescription} canonicalPath={pagePath} image={service.image} imageAlt={service.imageAlt} pageType="ItemPage" pageSchema={{ mainEntity: { '@id': `${pageUrl}#service` } }} schema={schema}>
  <section class="site-frame section-gap" aria-labelledby="service-title">
    <div class="panel grid bg-paper lg:grid-cols-[6fr_7fr]">
      <div class="section-pad flex flex-col justify-between gap-10 lg:gap-12">
        <div>
          <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: service.title }]} />
          <p class="eyebrow mt-6">{service.eyebrow}</p>
          <h1 id="service-title" class="display-title mt-4 max-w-[12ch]">{keywordLabel(seo.primaryKeyword)}</h1>
          <p class="body-large mt-5 text-ink/68">{service.description}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/contact/" class="button-primary">Plan this service<Arrow /></a>
            <a href="#service-details" class="button-secondary">See what is included<Arrow direction="down" /></a>
          </div>
        </div>
        <p class="m-0 max-w-sm border-t border-line pt-5 text-sm text-ink/55">Philadelphia and nearby communities. Site conditions and availability are confirmed for each request.</p>
      </div>
      <div class="relative min-h-[26rem] overflow-hidden border-t border-line lg:min-h-[42rem] lg:border-t-0 lg:border-l">
        <img src={service.image} alt={service.imageAlt} width="1600" height="1200" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section id="service-details" class="site-frame section-gap" aria-labelledby="details-title">
    <div class="panel section-pad">
      <div class="grid-5-8">
        <div>
          <p class="eyebrow">What the plan covers</p>
          <h2 id="details-title" class="section-title mt-4">Typical scope for {service.title.toLowerCase()}.</h2>
          <p class="mt-4 text-ink/65">Final scope follows the site. These are the core decisions this service typically requires.</p>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h3 class="text-xs font-extrabold tracking-[0.14em] text-brick uppercase">Best suited to</h3>
            <ul class="rule-list mt-5 border-t border-line p-0" role="list">
              {service.bestFor.map((item) => <li class="flex gap-3 py-4 text-sm font-semibold"><span class="mt-2 h-2 w-2 flex-none bg-signal"></span>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-xs font-extrabold tracking-[0.14em] text-brick uppercase">Operating details</h3>
            <ul class="rule-list mt-5 border-t border-line p-0" role="list">
              {service.deliverables.map((item) => <li class="flex gap-3 py-4 text-sm font-semibold"><span class="mt-2 h-2 w-2 flex-none bg-signal"></span>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-frame section-gap" aria-labelledby="planning-factors-title">
    <div class="panel section-pad">
      <div class="grid-5-8">
        <div>
          <p class="eyebrow">Plan-shaping factors</p>
          <h2 id="planning-factors-title" class="section-title mt-4">What changes {service.shortTitle.toLowerCase()} staffing and vehicle flow.</h2>
          <p class="mt-4 text-ink/65">These details turn a service category into an operating plan for the property. They are resolved before staffing is finalized.</p>
        </div>
        <div class="grid gap-px border border-line bg-line sm:grid-cols-2">
          {service.planningFactors.map((factor, index) => (
            <article data-planning-factor class="bg-paper p-6 sm:p-8">
              <span class="text-xs font-extrabold text-brick">0{index + 1}</span>
              <h3 class="card-title mt-5">{factor.title}</h3>
              <p class="mt-4 text-sm text-ink/66">{factor.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="site-frame section-gap" aria-labelledby="service-process-title">
    <div class="panel panel-dark section-pad">
      <div class="grid-7-6 lg:items-end">
        <div>
          <p class="eyebrow">Three working phases</p>
          <h2 id="service-process-title" class="section-title mt-4">How {service.title.toLowerCase()} is planned and supervised.</h2>
        </div>
        <p class="text-white/62">The crew should not discover the important details at guest arrival. The sequence turns site facts into positions, handoffs, and live decisions.</p>
      </div>
      <ol class="mt-8 grid gap-4 lg:grid-cols-3" role="list">
        {service.process.map((step) => (
          <li class="border border-white/12 bg-white/[0.04] p-6 sm:p-8">
            <span class="text-xs font-extrabold text-signal">{step.number}</span>
            <h3 class="card-title mt-6">{step.title}</h3>
            <p class="mt-4 text-sm text-white/62">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="site-frame section-gap" aria-labelledby="service-faq-title">
    <div class="panel section-pad">
      <div class="grid-5-8">
        <div>
          <p class="eyebrow">Questions about {service.shortTitle.toLowerCase()}</p>
          <h2 id="service-faq-title" class="section-title mt-4">{service.shortTitle} planning questions.</h2>
          <p class="mt-4 text-ink/64">The answers establish what is known, what still requires a site review, and which property contacts should join the planning conversation.</p>
          <a href="/faq/" class="button-secondary mt-6">All valet FAQs<Arrow /></a>
        </div>
        <FAQList items={service.faqs} />
      </div>
    </div>
  </section>

  <section class="site-frame section-gap" aria-labelledby="related-title">
    <div class="panel section-pad">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Related services</p>
          <h2 id="related-title" class="section-title mt-4">Services related to {service.shortTitle.toLowerCase()}.</h2>
        </div>
        <a href="/services/" class="text-link">All services <span class="arrow-circle"><Arrow /></span></a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {relatedServices.map((item, index) => <ServiceCard service={item} index={index} />)}
      </div>
    </div>
  </section>

  <QuoteCta eyebrow="Request service details" title={`Send the ${service.title.toLowerCase()} schedule and expected vehicle volume.`} body="Include the guest entrance, available parking, vehicle route, and any known curb constraint." />
</BaseLayout>
