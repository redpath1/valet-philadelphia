---
import Arrow from '../components/Arrow.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routesByGroup } from '../lib/routes';
import { siteConfig } from '../data/site';
import { getKeywordTarget } from '../lib/seo-keywords';

const seo = getKeywordTarget('/sitemap/');
---

<BaseLayout
  title={seo.primaryKeyword}
  description="Browse every public page on the Valet Philadelphia website, including services, locations, planning answers, and contact information."
  canonicalPath="/sitemap/"
  pageType="CollectionPage"
  schema={{
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'HTML sitemap', item: `${siteConfig.url}/sitemap/` },
    ],
  }}
>
  <section class="site-frame section-gap" aria-labelledby="sitemap-title">
    <div class="panel panel-river section-pad">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Sitemap' }]} />
      <p class="eyebrow mt-8">Human-readable sitemap</p>
      <h1 id="sitemap-title" class="display-title mt-7 max-w-[11ch]">Every useful page, in one <em class="text-brick">place.</em></h1>
      <p class="body-large mt-7 text-ink/68">Browse the main site, compare {seo.supportingKeywords[0]}, or open one of the local {seo.supportingKeywords[1]} for Philadelphia and nearby areas.</p>
    </div>
  </section>

  {Object.entries(routesByGroup).map(([group, routes]) => (
    <section class="site-frame section-gap" aria-labelledby={`${group.toLowerCase()}-routes`}>
      <div class="panel section-pad">
        <p class="eyebrow">{group}</p>
        <h2 id={`${group.toLowerCase()}-routes`} class="section-title mt-6">{group === 'Main' ? 'Start here.' : group}</h2>
        <div class="rule-list mt-10 border-t border-line">
          {routes.map((route) => (
            <a href={route.href} class="group grid gap-3 py-5 no-underline sm:grid-cols-[0.65fr_1.35fr_auto] sm:items-center">
              <h3 class="m-0 text-lg font-bold tracking-[-0.02em]">{route.label}</h3>
              <p class="m-0 text-sm text-ink/62">{route.description}</p>
              <span class="arrow-circle"><Arrow /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
