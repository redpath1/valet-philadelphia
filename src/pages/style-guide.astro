---
import Arrow from '../components/Arrow.astro';
import FAQList from '../components/FAQList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';

const sampleFaqs = [
  { question: 'What does a standard disclosure look like?', answer: 'It uses plain language, visible hierarchy, and enough contrast to work without relying on motion or color alone.' },
  { question: 'How are contained sections handled?', answer: 'Every section sits within the shared site frame and uses square panel edges, borders, and internal spacing tokens.' },
];
---

<BaseLayout title="Style Guide" description="Design system reference for the Valet Philadelphia website." canonicalPath="/style-guide/" noindex={true}>
  <section class="site-frame section-gap">
    <div class="panel section-pad">
      <p class="eyebrow">Internal design reference</p>
      <h1 class="display-title mt-4">Valet Philadelphia style guide.</h1>
      <p class="body-large mt-5 text-ink/65">A practical inventory of the tokens and components used across the site.</p>
    </div>
  </section>

  <section class="site-frame section-gap">
    <div class="panel section-pad">
      <p class="eyebrow">Wordmark</p>
      <p class="mt-5 text-ink/60">One name, one typeface, one weight, and no symbol.</p>
      <div class="mt-6 border-y border-line py-8 text-navy">
        <Wordmark class="text-[clamp(1.5rem,3vw,2.5rem)]" />
      </div>
    </div>
  </section>

  <section class="site-frame section-gap">
    <div class="panel section-pad">
      <p class="eyebrow">Color</p>
      <h2 class="section-title mt-4">Site colors.</h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Navy', 'bg-navy text-white', '#102A3D'],
          ['Limestone', 'bg-limestone', '#F1EEE5'],
          ['Signal', 'bg-signal', '#F1C84B'],
          ['Brick', 'bg-brick text-white', '#A64A32'],
          ['River', 'bg-river', '#C9DBE0'],
          ['Paper', 'bg-paper', '#FBFAF6'],
          ['Ink', 'bg-ink text-white', '#101B24'],
          ['Mist', 'bg-mist', '#E2E8E8'],
        ].map(([name, classes, value]) => (
          <div class={`border border-line p-5 ${classes}`}>
            <strong>{name}</strong>
            <span class="mt-5 block text-xs opacity-60">{value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="site-frame section-gap">
    <div class="panel section-pad">
      <p class="eyebrow">Typography</p>
      <h2 class="display-title mt-4">Display title example.</h2>
      <h3 class="section-title mt-8">Section title example.</h3>
      <h4 class="card-title mt-6">Card and subsection title.</h4>
      <p class="body-large mt-5 text-ink/65">Large body copy explains the important premise without turning every paragraph into a headline.</p>
      <p class="mt-5 max-w-2xl text-ink/65">Standard body copy handles details, qualifications, and practical explanations.</p>
    </div>
  </section>

  <section class="site-frame section-gap">
    <div class="panel section-pad">
      <p class="eyebrow">Actions and disclosure</p>
      <h2 class="section-title mt-4">Actions and disclosures.</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button-primary" href="#">Primary action<Arrow /></a>
        <a class="button-secondary" href="#">Secondary action<Arrow /></a>
        <a class="text-link" href="#">Text action <span class="arrow-circle"><Arrow /></span></a>
      </div>
      <div class="mt-8"><FAQList items={sampleFaqs} /></div>
    </div>
  </section>

  <section class="site-frame section-gap">
    <div class="panel grid lg:grid-cols-2">
      <div class="relative min-h-[30rem] overflow-hidden">
        <img src="/images/restaurant-valet-arrival.webp" alt="Sample editorial valet photography" width="1600" height="1200" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="section-pad flex flex-col justify-center">
        <p class="eyebrow">Photography</p>
        <h2 class="section-title mt-4">Photography direction.</h2>
        <p class="mt-4 text-ink/65">Images show working attendants, real curbs, mixed light, practical uniforms, and recognizable parking activity. They avoid staged team portraits and showroom polish.</p>
      </div>
    </div>
  </section>
</BaseLayout>
