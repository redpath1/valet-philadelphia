---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The requested Valet Philadelphia page could not be found." noindex={true}>
  <section class="site-frame section-gap">
    <div class="panel panel-river section-pad flex min-h-[28rem] items-center">
      <div>
        <p class="eyebrow">Error 404</p>
        <h1 class="display-title mt-4 max-w-[11ch]">Page not found.</h1>
        <p class="body-large mt-5 text-ink/68">Return home, browse services, or open the sitemap to find the page you need.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/" class="button-primary">Return home<Arrow /></a>
          <a href="/sitemap/" class="button-secondary">View sitemap<Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
