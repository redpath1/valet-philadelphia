---
import type { Location } from '../data/locations';
import Arrow from './Arrow.astro';

interface Props {
  location: Location;
  index?: number;
}

const { location, index = 0 } = Astro.props;
---

<article class="group flex min-h-full flex-col border border-line bg-paper p-5 sm:p-6">
  <div class="flex items-center justify-between gap-4">
    <span class="text-[0.68rem] font-extrabold tracking-[0.14em] text-ink/38 uppercase">Service area 0{index + 1}</span>
    <span class="arrow-circle text-navy"><Arrow direction="up-right" /></span>
  </div>
  <p class="mt-5 text-xs font-bold tracking-[0.12em] text-brick uppercase">{location.region}</p>
  <h2 class="card-title mt-3"><a class="no-underline" href={`/locations/${location.slug}/`}>{location.name}</a></h2>
  <p class="mt-3 flex-1 text-ink/66">{location.summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {location.areas.slice(0, 3).map((area) => <span class="border border-line px-3 py-1 text-xs font-semibold text-ink/62">{area}</span>)}
  </div>
  <a href={`/locations/${location.slug}/`} class="text-link mt-5">View area details <span class="arrow-circle"><Arrow /></span></a>
</article>
