---
import type { Service } from '../data/services';
import Arrow from './Arrow.astro';

interface Props {
  service: Service;
  index?: number;
}

const { service, index = 0 } = Astro.props;
---

<article class="group grid min-h-full overflow-hidden border border-line bg-paper">
  <a href={`/services/${service.slug}/`} class="relative block aspect-[4/3] overflow-hidden no-underline" aria-label={`Explore ${service.title}`}>
    <img
      src={service.image}
      alt={service.imageAlt}
      width="1200"
      height="900"
      loading={index < 2 ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover"
    />
    <span class="absolute top-4 left-4 border border-line bg-paper px-3 py-1.5 text-[0.68rem] font-extrabold tracking-[0.12em] text-navy uppercase">0{index + 1}</span>
  </a>
  <div class="flex flex-col p-5 sm:p-6">
    <p class="eyebrow">{service.eyebrow}</p>
    <h2 class="card-title mt-4"><a class="no-underline" href={`/services/${service.slug}/`}>{service.title}</a></h2>
    <p class="mt-3 text-ink/66">{service.summary}</p>
    <a href={`/services/${service.slug}/`} class="text-link mt-5">
      View service details <span class="arrow-circle"><Arrow /></span>
    </a>
  </div>
</article>
