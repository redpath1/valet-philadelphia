---
import Arrow from './Arrow.astro';
import { siteConfig } from '../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
}

const {
  eyebrow = 'Start with the site',
  title = 'Tell us what happens at your curb.',
  body = 'Share the venue, date or operating schedule, expected volume, and available parking. We will start with the movement plan.',
} = Astro.props;
---

<section class="site-frame section-gap" aria-labelledby="quote-cta-title">
  <div class="panel panel-river section-pad">
    <div class="grid items-end gap-10 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="quote-cta-title" class="section-title mt-6 max-w-[14ch]">{title}</h2>
        <p class="body-large mt-6 text-ink/68">{body}</p>
      </div>
      <a href="/contact/" class="button-primary whitespace-nowrap">{siteConfig.primaryCta}<Arrow /></a>
    </div>
  </div>
</section>
