---
import Arrow from './Arrow.astro';
import { siteConfig } from '../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
}

const {
  eyebrow = 'Request a parking plan',
  title = 'Share the address and operating schedule.',
  body = 'Include the expected vehicle volume, guest entrance, and available parking. Those details determine the next site questions.',
} = Astro.props;
---

<section class="site-frame section-gap" aria-labelledby="quote-cta-title">
  <div class="panel panel-river section-pad">
    <div class="grid-8-5 items-end">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="quote-cta-title" class="section-title mt-4 max-w-[16ch]">{title}</h2>
        <p class="body-large mt-4 text-ink/68">{body}</p>
      </div>
      <a href="/contact/" class="button-primary justify-self-start whitespace-nowrap lg:justify-self-end">{siteConfig.primaryCta}<Arrow /></a>
    </div>
  </div>
</section>
