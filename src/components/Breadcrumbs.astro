---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs font-semibold text-ink/54">
  <ol class="flex flex-wrap items-center gap-2 p-0" role="list">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {item.href ? <a class="no-underline hover:text-ink" href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
