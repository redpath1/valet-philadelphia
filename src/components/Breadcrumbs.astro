---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  inverse?: boolean;
}

const { items, inverse = false } = Astro.props;
---

<nav
  aria-label="Breadcrumb"
  class:list={['text-xs font-semibold', inverse ? 'text-white/60' : 'text-ink/54']}
>
  <ol class="flex flex-wrap items-center gap-2 p-0" role="list">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {item.href ? <a class:list={['no-underline', inverse ? 'hover:text-white' : 'hover:text-ink']} href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
