---
import Arrow from './Arrow.astro';
import Wordmark from './Wordmark.astro';
import { primaryNavigation, siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div class="site-frame pt-3 sm:pt-4">
  <header class="relative z-50 flex min-h-[4.25rem] items-center justify-between border border-line bg-paper px-3 sm:px-5" aria-label="Primary navigation">
    <a href="/" class="text-navy no-underline" aria-label="Valet Philadelphia home">
      <Wordmark class="text-[1.125rem] sm:text-[1.25rem]" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Desktop navigation">
      {primaryNavigation.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'border-b-2 px-3.5 py-2 text-[0.82rem] font-semibold no-underline transition-colors',
            isActive(item.href) ? 'border-navy text-ink' : 'border-transparent text-ink/70 hover:border-line hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden xl:block">
      <a href="/contact/" class="button-primary min-h-11 py-2">
        {siteConfig.primaryCta}
        <Arrow />
      </a>
    </div>

    <details class="group lg:hidden">
      <summary class="flex h-11 min-w-12 items-center justify-center border border-line bg-white text-sm font-bold" aria-label="Site menu">
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <div class="absolute top-[calc(100%+0.5rem)] right-0 left-0 border border-line bg-paper p-3">
        <nav class="flex flex-col" aria-label="Mobile navigation">
          {primaryNavigation.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between px-4 py-3 text-base font-semibold no-underline',
                isActive(item.href) ? 'bg-navy text-white' : 'hover:bg-mist',
              ]}
            >
              {item.label}
              <Arrow />
            </a>
          ))}
          <a href="/contact/" class="button-primary mt-2">{siteConfig.primaryCta}<Arrow /></a>
        </nav>
      </div>
    </details>
  </header>
</div>
