---
import Arrow from './Arrow.astro';
import BrandMark from './BrandMark.astro';
import { primaryNavigation, siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div class="site-frame pt-3 sm:pt-4">
  <header class="relative z-50 flex min-h-16 items-center justify-between rounded-[1.25rem] border border-white/70 bg-paper/95 px-3 shadow-soft backdrop-blur sm:px-5" aria-label="Primary navigation">
    <a href="/" class="flex items-center gap-2.5 text-navy no-underline" aria-label="Valet Philadelphia home">
      <BrandMark />
      <span class="leading-none">
        <span class="block text-[0.92rem] font-extrabold tracking-[-0.03em]">Valet Philadelphia</span>
        <span class="mt-1 block text-[0.62rem] font-bold tracking-[0.14em] text-ink/50 uppercase">Philadelphia, PA</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Desktop navigation">
      {primaryNavigation.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3.5 py-2 text-[0.82rem] font-semibold no-underline transition-colors',
            isActive(item.href) ? 'bg-navy text-white' : 'text-ink/70 hover:bg-mist hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden xl:block">
      <a href="/contact/" class="button-primary min-h-11 py-2">
        {siteConfig.primaryCta}
        <Arrow />
      </a>
    </div>

    <details class="group lg:hidden">
      <summary class="flex h-11 min-w-12 items-center justify-center rounded-full border border-line bg-white text-sm font-bold" aria-label="Site menu">
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <div class="absolute top-[calc(100%+0.5rem)] right-0 left-0 rounded-[1.25rem] border border-line bg-paper p-3 shadow-soft">
        <nav class="flex flex-col" aria-label="Mobile navigation">
          {primaryNavigation.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between rounded-xl px-4 py-3 text-base font-semibold no-underline',
                isActive(item.href) ? 'bg-navy text-white' : 'hover:bg-mist',
              ]}
            >
              {item.label}
              <Arrow />
            </a>
          ))}
          <a href="/contact/" class="button-primary mt-2">{siteConfig.primaryCta}<Arrow /></a>
        </nav>
      </div>
    </details>
  </header>
</div>
