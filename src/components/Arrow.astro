---
interface Props {
  direction?: 'right' | 'down' | 'up-right';
  class?: string;
}

const { direction = 'right', class: className = 'h-4 w-4' } = Astro.props;
const path = {
  right: 'M5 12h14m-6-6 6 6-6 6',
  down: 'M12 5v14m6-6-6 6-6-6',
  'up-right': 'M7 17 17 7M8 7h9v9',
}[direction];
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={path}></path>
</svg>
